APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_intel
REDIS_URL=redis://localhost:6379/0
NEWS_API_KEY=replace_with_newsapi_key

CORS_ORIGINS=http://localhost:5173
REQUESTS_PER_MINUTE=120
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

SENTIMENT_VADER_WEIGHT=0.4
SENTIMENT_FINBERT_WEIGHT=0.6
SENTIMENT_BUY_THRESHOLD=0.10
SENTIMENT_NEUTRAL_BAND=0.05

NEWS_CACHE_TTL_SECONDS=600
SENTIMENT_CACHE_TTL_SECONDS=1800
PREDICTION_CACHE_TTL_SECONDS=1800

TARGET_STOCKS=AAPL,TSLA,GOOGL,AMZN,MSFT,NVDA,META,NFLX
INITIAL_CAPITAL=100000
MAX_POSITION_SIZE=20000
MIN_TRADE_AMOUNT=10
SCAN_INTERVAL_SECONDS=60

MODEL_DIR=artifacts/models
LSTM_SEQUENCE_LENGTH=45
LSTM_HIDDEN_SIZE=32
LSTM_EPOCHS=10
LSTM_LEARNING_RATE=0.001
LSTM_BATCH_SIZE=16
