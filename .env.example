# Copy to .env and fill in. Never commit .env.
# All variables are optional for the synthetic demo and the test suite.

# Where downloaded data is cached and where the forward ledger lives.
SIGAUDIT_DATA_DIR=data/cache
SIGAUDIT_LEDGER_PATH=ledger/predictions.jsonl

# Reddit official Data API (https://www.reddit.com/prefs/apps, "script" app).
# Free for approved non-commercial use.
SIGAUDIT_REDDIT_CLIENT_ID=
SIGAUDIT_REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive user agent. Set your own here.
SIGAUDIT_REDDIT_USER_AGENT=signal-audit-lab/0.1 (research; non-commercial)
